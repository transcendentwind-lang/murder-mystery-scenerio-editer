{
  "name": "mm-workbench",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "playwright test",
    "assets:prepare": "node scripts/prepare-scenario-assets.mjs",
    "assets:check": "node scripts/prepare-scenario-assets.mjs --check",
    "local-projects:prepare": "node scripts/prepare-local-projects.mjs",
    "predev": "npm run local-projects:prepare && npm run assets:prepare",
    "prebuild": "npm run local-projects:prepare && npm run assets:prepare",
    "prestart": "npm run local-projects:prepare && npm run assets:prepare",
    "postbuild": "node scripts/finalize-participant-export.mjs",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.71.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
